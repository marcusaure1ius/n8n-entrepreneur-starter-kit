# Copy this file to .env. Never commit the resulting .env.
# install.sh will generate secrets in T-0006; for a manual smoke test, generate
# independent values with: openssl rand -base64 36

# Optional custom DNS name. Leave empty to use n8n-<public-ip>.sslip.io.
N8N_HOST=

# Optional legacy ACME contact. Caddy does not require it for the default path.
ACME_EMAIL=

# IANA timezone used by n8n and container logs.
TIMEZONE=Europe/Moscow

# Exact research-approved n8n version. update.sh changes this atomically.
N8N_VERSION=2.29.10
N8N_IMAGE_SOURCE=official
POSTGRES_IMAGE=postgres:17.10-bookworm
N8N_IMAGE_REPOSITORY=docker.n8n.io/n8nio/n8n
CADDY_IMAGE=caddy:2.11.4-alpine

# PostgreSQL identity. Leave database/user defaults unless you know why to
# change them. Both secrets below must be non-empty before Compose validation.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Execution retention. Execution payloads can contain personal data.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
